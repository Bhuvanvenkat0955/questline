{
  "name": "goal-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "app:electron": "node node_modules/electron/install.js",
    "app:compile": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist-electron/main.cjs",
    "app:build:server": "next build && node scripts/prepare-desktop.mjs",
    "app:dev": "npm run app:electron && npm run app:compile && electron . --dev-url=http://localhost:3000",
    "app:start": "npm run app:electron && npm run app:build:server && npm run app:compile && electron .",
    "app:dist": "npm run app:electron && npm run app:build:server && npm run app:compile && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@number-flow/react": "^0.6.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "pixelarticons": "^2.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "productName": "Questline",
  "main": "dist-electron/main.cjs",
  "description": "Turn any big goal into a game: worlds to clear and daily quests that fit your day."
}
